{
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2023",
        "lib": ["es2023"],
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "skipLibCheck": true
    },
    "include": ["src", "eslint.config.ts"]
}
